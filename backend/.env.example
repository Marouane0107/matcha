PORT=3000
CORS_ORIGIN=http://localhost:5173

# Environment: development, test or production. Reset/seed refuse to run in production.
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=matcha_db

# Development-only seed password shared by all seeded accounts
SEED_DEFAULT_PASSWORD=Matcha123!

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP / Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password