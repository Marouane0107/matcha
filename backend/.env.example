PORT=3000
CORS_ORIGIN=http://localhost:5173

# Reset/seed also require a local dev/test database and exact DB_CONFIRM_NAME.
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=matcha_dev
DB_CONFIRM_NAME=

# Development-only seed password shared by all seeded accounts
SEED_DEFAULT_PASSWORD=

# JWT Configuration: generate at least 32 random bytes locally.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# SMTP / Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=