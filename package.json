{
  "name": "matcha",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.20.0", "npm": ">=10" },
  "scripts": {
    "dev": "concurrently --kill-others -n frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}